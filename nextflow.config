/*
 * -------------------------------------------------
 *  PIPPA Nextflow config file -- ICR --
 * -------------------------------------------------
 */

    params {

      searchid 	          = '1'

      //DIRECTORY PATHS 
      mzml_dir              = './mzml' 
      database_dir          = './db'
      out_dir               = "./results"
      log_dir               = './logs'
      sample_info           = "$baseDir/data/default_sample.tsv" //Path to sample Information File if available (TSV with ExperimentID, TMTLabel, and SampleID Columns).
      mutation_table        = "$baseDir/data/cosmic_mutations.tsv"

      //SPECTRAL PROCESSING
      mzml_merge          = true
      mzml_merge_pattern  = '.*'  //This is a regular expression which will group mzmls to be merged

      //Build Mutant Proteoform fasta
      build_mutant_db     = true
      cosmic_aa_reference = "$baseDir/data/gencode.pc_translations.fa"
      cosmic_na_reference = "$baseDir/data/gencode.pc_transcripts.fa"
      cosmic_dist         = 30
      cosmic_lockversion  = false
      cosmic_old          = false

      //DecoyPYrate params
      decoy_name            = "tryp" // use to create different decoy files for different digest types
      decoypyrate_pfasta    = false 
      decoypyrate_memsave   = false  // Set true for HLA
      decoypyrate_csites    = 'KR'  // Set to 'X' for HLA
      decoypyrate_non_csites = 'P'  // Set to 'X' for HLA
      decoypyrate_cpos       = 'c'  // Set to 'x' for HLA Note lower case
      decoypyrate_min_length  = 6  // Set to 8 for HLA
      decoypyrate_max_length  = 60 // Set to 13 for HLA
      decoypyrate_max_it      = 100
      decoypyrate_max_sub     = 10
      
      //Search parameters
      use_pep_calc        = false // Use basic PEP calculator rather than Percolator
      enzyme              = 'Trypsin/P'
      cleavage_termini    = 'fully'
      missed_cleavages    = 2
      msgf_missed_cleavages   = 2
      precursor_tolerance = 20
      precursor_tol_units = 'ppm'
      fixed_modifications = 'Carbamidomethyl (C)'
      var_modifications   = 'Oxidation (M)'
      instrument_type     = 'low_res' //high_res for HCD MS2
      min_pre_charge      = 2
      max_pre_charge      = 3
      min_pep_length      = 6
      max_pep_length      = 63
      hit_ranks           = 1
      max_modifications   = 2
      unmatched_peptide_action    = 'warn'

      //msfragger specific
      use_msfragger     = false
      java_path         = "$projectDir/env/openms/bin/java"
      //Must be downloaded seperatly and path to jar set here:
      msfragger_path    = "$projectDir/bin/MSFragger-4.1/MSFragger-4.1.jar"
      msfragger_pre_true_tol = 0.0 
      msfragger_pre_true_tol_units = 'ppm'
      msfragger_frag_tol = 0.5 
      msfragger_frag_tol_units = 'Da'
      msfragger_isotope_err = 0
      msfragger_enzyme_name = 'Trypsin' //no spaces allowed
      msfragger_enzyme_cutafter = 'KR' //(use '@' for non-specific)
      msfragger_enzyme_nocutbefore = 'P'
      msfragger_enzyme_numtermini = 'fully' //(valid: 'non-enzymatic', 'semi', 'fully')
      msfragger_digest_min_mass = 500
      msfragger_digest_max_mass = 5000
      msfragger_clip_nterm_m = false
      msfragger_varmod_multi = false
      msfragger_varmod_maxmod = 2
      msfragger_varmod_maxcomb = 5000
      msfragger_minpeaks = 10
      msfragger_topnpeaks = 50
      msfragger_minratio = 0.0
      msfragger_clear_mz_min = 0.0
      msfragger_clear_mz_max = 0.0
      msfragger_max_frag_charge = 2
      msfragger_override_charge = false
      msfragger_min_charge = 1
      msfragger_max_charge = 4
      msfragger_track_zero_topn = 0
      msfragger_zero_bin_accept_expect = 0.0
      msfragger_zero_bin_mult_expect = 1.0
      msfragger_add_topn_comp = 0
      msfragger_min_frag_modeling = 3 
      msfragger_min_frag_matched = 4
      msfragger_report_topn = 1
      msfragger_max_evalue = 50
      msfragger_local_deltamass = 0
      msfragger_reindex = true

      //msgf specific
      use_msgf          = false 
      msgf_enzyme	      = 'Trypsin/P'
      msgf_isotope_error  = '0,1'
      msgf_tasks          = 0
      msgf_cleavage_termini = 'fully'
      //Check conda env for correct path:
      msgf_path           = '$CONDA_PREFIX/share/msgf_plus-2024.03.26-0/MSGFPlus.jar' // share/msgf_plus-2023.01.1202-1/MSGFPlus.jar old version

      //comet specific
      use_comet         = true
      com_enzyme	      = 'Trypsin/P'
      com_frag_tolerance  = 0.5
      com_clip_met        = 'true'
      com_frag_bin_offset = '0.4'
      com_isotope_error   = 'off'
      com_a_ion           = 'false'
      com_b_ion           = 'true'
      com_c_ion           = 'false'
      com_x_ion           = 'false'
      com_y_ion           = 'true'
      com_z_ion           = 'false'
      com_nl_ion          = 'true'
      com_second_enzyme   = ''              
      com_override_charge = 'keep known search unknown'                         
      com_mslevel         = 2                                        
      com_mass_range      = '600:5000'               
      com_max_frag_charge = 3                 
      com_batch_size      = '20000'
      com_min_peaks       = '10' 
      com_min_intensity   = '0.0'   
      com_remove_pre      = 'no'
      com_remove_pre_tol  = '1.5'           
      com_clear_mz        = '0:0'   
      com_binary_mod      = ''
      com_require_mod      = 'false' 

      // Protein Inference
      pq_top = 3
      pq_average = 'median'

      //QUANTIFICATION
      tmt 		            = true
      isotype             = 'tmt10plex'  //Isobaric Quantitation method used in the experiment. ('itraq4plex' valid: 'itraq4plex', 'itraq8plex', 'tmt10plex', 'tmt11plex', 'tmt16plex', 'tmt6plex')
      ms3_quant 		      = true // set to false for MS2 Quantification methods
      tmt_channel_threshold = 0.05 //TMT channels must be atleast this fraction of the highest summed intensity channel to be included in results.
      qactivation         = 'any' //for Isobaric Analyser eg. 'Collision-induced dissociation'  - defaults to any

      //Summary Annotation
      reference_fasta           = "$baseDir/data/reference_sequences.fasta"
      peptide_fdr_threshold     = 0.01
      psm_pep_threshold         = 0.05
      psm_fdr_threshold         = 0.01
      summary_write_mztab       = false

      //Mutant Proteoform Analyser
      mutant_proteoforms    = true
      mutation_info         = "$baseDir/data/mutation_info.tsv"
      control_channel_name  = 'bridge'

    }

    process{
      executor  = 'local'
      cpus      = 1
      conda = "$baseDir/env/openms"
    }  

    conda.enabled = true
    conda.createTimeout = '1 h'


// Order of profiles on commandline is important later profiles override earlier profiles 
profiles {

  slurm {
    process{
      executor        = 'slurm'
      queue	          = 'compute'
      time            = '24 h'
      clusterOptions  = '--job-name=nxf_pippa --output=nxf_pippa.txt '
      cpus            = 4

      withLabel:Quick_Task {
        time = '1 h'
      }
      withLabel:Slow_Task {
        time = '48 h'
      }
      withLabel:Small_Task {
        cpus = 1
      }
      withLabel:Medium_Task {
        cpus = 6
      	time = '48 h'
      }
      withLabel:Medium_mem{
	      cpus=12
      }
      withLabel:Big_Task {
        cpus = 12
        time = '60 h'
      }
      withLabel:MSGF_Task {
        cpus = 12
        time = '100 h'
      }
      withLabel:Comet_Task {
        cpus = 8
        time = '60 h'
      }
      withLabel:MSFRAG_Task {
        cpus = 8
        time = '60 h'
      }
      withLabel:Summary_Task {
        cpus = 6
        time = '120 h'
      }
      withLabel:CE_Task {
	      cpus = 16
	      time= '60h'
      }
   }
 }

 TMT10MS3 {
    params {

      use_comet = true
      use_msfragger = true
      use_msgf = true
      
      fixed_modifications     = 'Carbamidomethyl (C),TMT6plex (K),TMT6plex (N-term)'
      var_modifications       = 'Oxidation (M),Deamidated (N),Deamidated (Q)'
      tmt = true
      isotype                 = 'tmt10plex'
      ms3_quant               = true
      instrument_type         = 'low_res'
      com_frag_tolerance      = 0.5
      com_frag_bin_offset     = '0.4'

      peptide_fdr_threshold   = 0.01
      psm_pep_threshold       = 0.05
      psm_fdr_threshold       = 0.01
	 
    }
 }
}
